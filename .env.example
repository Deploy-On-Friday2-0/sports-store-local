# Compose-level configuration. Copy to .env and adjust.
# MongoDB root credentials — change outside local dev.
MONGO_ROOT_PASSWORD=dev-mongo-pw-change-me
# Shared signing secret for all services — change outside local dev.
JWT_SECRET=dev-secret-change-me
# Cards ending with this suffix are declined by the mock payment provider.
PAYMENT_FAILURE_SUFFIX=0000

# Optional AI PR reviewer. Configure the real key as a GitHub Actions secret.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_CONTEXT_TOKENS=128000
OPENROUTER_MAX_OUTPUT_TOKENS=4000
OPENROUTER_REQUIRE_STRUCTURED_OUTPUTS=true
OPENROUTER_REQUIRE_ZERO_DATA_RETENTION=false
OPENROUTER_DENY_DATA_COLLECTION=false
